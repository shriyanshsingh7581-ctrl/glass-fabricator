# Optional Vercel / Vite Environment Variable Overrides
# Note: The app already works out-of-the-box using firebase-applet-config.json,
# so you do NOT need to set any environment variables on Vercel unless you wish to override them.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
